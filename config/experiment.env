LLM_MODEL=qwen3:4b
EMBED_MODEL=embeddinggemma
TOKENIZER_PATH=models/qwen3-4b-tokenizer.json
MODEL_CONTEXT=4096
MODEL_OUTPUT=700
HISTORY_TURNS=6
HISTORY_CHARS=4000
TOP_K=8
CONTEXT_CHARS=12000
MODEL_KEEP_ALIVE_SECONDS=600
EMBED_KEEP_ALIVE_SECONDS=600
MODEL_GPU_LAYERS=99
EMBED_GPU_LAYERS=0

AGENT_MAX_SEARCHES=3
AGENT_MAX_ACTIONS=8
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_DOCUMENTS=8
